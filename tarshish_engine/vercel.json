{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{storefront/**,dashboard/**,tests/**,output/**,logs/**,public/**,.venv/**,.pytest_tmp/**,**/__pycache__/**,*.db,*.db-*,README.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
