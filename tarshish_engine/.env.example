# Copy to `.env` and fill in what you need. Everything is optional: with no keys the
# engine runs fully offline (template captions, console output).
# Secrets live ONLY here — social accounts (config/social_accounts.yaml / the dashboard)
# reference these variables by name.

# ── AI providers ────────────────────────────────────────────────────────────
# Without a key the matching provider falls back to the offline template writer.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model used when a content profile says `llm_model: anthropic` / `gemini` without a model id.
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite
# Thinking depth for Claude captions: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=low
# LLM_MAX_OUTPUT_TOKENS=4096
# Extend / correct the built-in price table: {"model-prefix": [usd_in_per_mtok, usd_out_per_mtok]}
# LLM_PRICE_OVERRIDES={"my-model": [1.0, 5.0]}

# ── Financial guardrail ─────────────────────────────────────────────────────
# LLM calls halt once this calendar month's AI spend reaches the cap (USD).
MAX_MONTHLY_AI_BUDGET_USD=5.0

# ── Telegram ────────────────────────────────────────────────────────────────
# Referenced by the (sports, he, telegram) social account (token_env_var / account_id_env_var).
TG_SPORTS_BOT_TOKEN=
TG_SPORTS_CHAT_ID=
# Defaults for Telegram accounts that do not name their own variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Append an "affiliate link" disclosure line to every post (recommended).
# AFFILIATE_DISCLOSURE=true

# ── Temu source (plugins/sources/temu_rapidapi.py) ──────────────────────────
# The source walks an ordered chain of RapidAPI Temu endpoints (config/temu_providers.yaml)
# and stops at the first one that returns usable products. Plans meter SEARCHES (free tiers:
# 5 to 50 a month), so each provider gets ONE search per run and everything else is local.
#
# One RapidAPI key works for every API the account is subscribed to: this one is used by
# every provider whose own variable below is empty.
RAPIDAPI_KEY=
# Optional key per provider (the names are set with `api_key_env` in temu_providers.yaml).
# Use them for keys of other RapidAPI accounts — each account has its own monthly quota.
RAPIDAPI_KEY_TEMU_1=
RAPIDAPI_KEY_TEMU_2=
RAPIDAPI_KEY_TEMU_3=
RAPIDAPI_KEY_TEMU_4=
# The chain file, relative to the project. Without the file only the first provider is used.
# TEMU_PROVIDERS_CONFIG_PATH=config/temu_providers.yaml
# Seconds to wait for a search that runs as a background job. A job that takes longer is not
# lost: collect it with   python main.py --seed-temu --category <id> --job <id>
# TEMU_JOB_TIMEOUT=300
# Moves the first TemuProductScraperAdapter provider to another RapidAPI host (prefer the chain file).
# RAPIDAPI_TEMU_HOST=temu-product-scraper.p.rapidapi.com
# Your Temu affiliate tracking value. Empty = plain product links (a warning is logged).
TEMU_TRACKING_ID=
# How the affiliate link is built from the product URL: {url} and {tracking_id} are filled in.
# TEMU_AFFILIATE_URL_TEMPLATE={url}?_x_sessn_id={tracking_id}&refer_page_name=affiliate
# Items requested per search (larger batch = more to rank locally for the same quota cost).
# TEMU_MAX_ITEMS=20
# Currency of the prices, for providers that do not report one.
# TEMU_CURRENCY=USD

# ── AliExpress source (plugins/sources/aliexpress_rapidapi.py) ──────────────
# The source walks an ordered chain of RapidAPI AliExpress endpoints
# (config/aliexpress_providers.yaml) and stops at the first one that returns usable products.
# Each variable below is optional: an empty one falls back to RAPIDAPI_KEY (above).
# Values are masked as [REDACTED] in every log line.
RAPIDAPI_KEY_ALI_1=
RAPIDAPI_KEY_ALI_2=
RAPIDAPI_KEY_ALI_3=
# The chain file, relative to the project. Without the file the same three providers are used.
# ALIEXPRESS_PROVIDERS_CONFIG_PATH=config/aliexpress_providers.yaml
# Your AliExpress Portals tracking id. Empty = the API's own promotion link, or the plain product URL.
ALIEXPRESS_TRACKING_ID=
# How the affiliate link is built from a plain product URL: {url} and {tracking_id} are filled in.
# A promotion link the API already returns is kept as-is.
# ALIEXPRESS_AFFILIATE_URL_TEMPLATE={url}?aff_fcid={tracking_id}&aff_platform=portals-tool
# Items requested per search, and the currency for providers that do not report one.
# ALIEXPRESS_MAX_ITEMS=20
# ALIEXPRESS_CURRENCY=USD

# ── Instagram (plugins/publishers/instagram_pub.py) ─────────────────────────
# Instagram API with Unified Login (graph.facebook.com, no Facebook Page needed):
# a Professional (Business/Creator) account in a Meta Business Portfolio and a
# Business Integration / System User token with instagram_business_basic and
# instagram_business_content_publish. Check with: python main.py --verify-instagram
# Each row of the social-accounts matrix names its own variables (token_env_var /
# account_id_env_var); accounts that name none fall back to these two.
# (gadgets, he, instagram):
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# (gadgets, en, instagram) — a separate English account:
INSTAGRAM_ACCESS_TOKEN_GADGETS_EN=
INSTAGRAM_BUSINESS_ACCOUNT_ID_GADGETS_EN=
# INSTAGRAM_GRAPH_API_VERSION=v21.0

# ── TikTok (accounts are in the matrix; a tiktok_pub publisher plugin is not installed yet) ──
# TIKTOK_ACCESS_TOKEN_GADGETS_HE=
# TIKTOK_ACCESS_TOKEN_GADGETS_EN=

# ── Video generator (plugins/generators/ffmpeg_video_gen.py) ────────────────
# true = render product photos into a 1080x1920 slideshow with ffmpeg (must be on PATH);
# false = write a render-job manifest to output/render_jobs/ instead.
# VIDEO_RENDER_ENABLED=false

# ── Two-stage runs ──────────────────────────────────────────────────────────
# Stage 1 (--harvest): products kept per (category, source) per run.
HARVEST_LIMIT=20
# Stage 2 (--publish): default mode (override with --mode) and products per content type per run.
PUBLISHING_MODE=queued             # immediate | queued
PUBLISH_BATCH_LIMIT=5

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_MODE=local                 # local | cloud (cloud is a stub to implement)
LOCAL_MEDIA_DIR=output
MEDIA_RETENTION_DAYS=7             # 0 = never delete local media

# ── Persistence & logging ───────────────────────────────────────────────────
DATABASE_PATH=tarshish_engine.db
# Folder of the seed files categories.yaml, content_profiles.yaml, social_accounts.yaml.
# They seed SQLite on the first start; push later edits with  python main.py --sync-config
CONFIG_DIR=config
LOG_LEVEL=INFO
LOG_FILE=logs/tarshish_engine.log

# ── FindHub storefront API (python -m uvicorn api.server:app --port 8000) ───
# Browser origins allowed to call the API directly (comma-separated). The Next.js
# storefront proxies /api itself, so this only matters for other front ends.
# STOREFRONT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# A product is listed on the storefront only when it meets this standard.
# STOREFRONT_MIN_RATING=4.5
# STOREFRONT_MIN_ORDERS=200

# ── Queue worker (human-like pacing) ────────────────────────────────────────
WORKER_TIMEZONE=Asia/Jerusalem
WORKER_ACTIVE_HOURS_START=9        # posts only go out between these local hours
WORKER_ACTIVE_HOURS_END=22
WORKER_MIN_DELAY_SECONDS=600       # random gap between two posts on the same page
WORKER_MAX_DELAY_SECONDS=2700
WORKER_POLL_INTERVAL_SECONDS=30
