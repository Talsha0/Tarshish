# Copy to `.env` and fill in what you need. Everything is optional: with no keys the
# engine runs fully offline (template captions, console output).
#
# Production has no .env file: the same variables are set in each platform's settings —
# Vercel (API + storefront), Streamlit Community Cloud secrets (dashboard) and GitHub Actions
# repository secrets (scheduled engine runs). Which one needs what: ../DEPLOYMENT.md
# Secrets live ONLY here — social accounts (config/social_accounts.yaml / the dashboard)
# reference these variables by name.

# ── AI providers ────────────────────────────────────────────────────────────
# Without a key, content types routed to that provider are written by the free LLM chain below
# (with a warning in the run report), or by the offline templates when no free key is set either.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model used when a content profile says `llm_model: anthropic` / `gemini` without a model id.
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite
# Thinking depth for Claude captions: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=low
# LLM_MAX_OUTPUT_TOKENS=4096
# Extend / correct the built-in price table: {"model-prefix": [usd_in_per_mtok, usd_out_per_mtok]}
# LLM_PRICE_OVERRIDES={"my-model": [1.0, 5.0]}

# ── Free-tier LLM failover chain (plugins/generators/free_llm_chain.py) ─────
# Live FindHub copy (--generate-assets, admin "Generate Batch Now") walks these free tiers in order and
# moves to the next one as soon as a provider answers HTTP 429 / quota exhausted:
#   1. Google Gemini   gemini-2.5-flash, then gemini-2.0-flash   (GEMINI_API_KEY above, aistudio.google.com)
#   2. Groq            llama-3.3-70b-versatile                    (console.groq.com/keys)
#   3. OpenRouter      meta-llama/llama-3.3-70b-instruct:free     (openrouter.ai/keys)
# A provider without a key is skipped; with none set (or all exhausted) the offline templates write the copy.
# Every value is masked as [REDACTED] in all log output.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── FindHub links & generated promotional images ────────────────────────────
# The public storefront: Telegram posts link to {STOREFRONT_BASE_URL}/{lang}/p/{product id}, Story link
# stickers to /{lang}/c/{category} and /{lang}/p/{id}.
STOREFRONT_BASE_URL=http://localhost:3000
# Branded images (1080x1350 posts, 1080x1920 Stories/Reels/TikTok) are written here and served by the API
# at /media/... (the Next.js storefront proxies /media to the API).
# GENERATED_MEDIA_DIR=static/generated_media
# Public HTTPS origin of /media/... — Meta and TikTok download images from it. Empty = STOREFRONT_BASE_URL.
# With STORAGE_MODE=supabase the images are uploaded to the bucket and its public URL is used instead.
# MEDIA_PUBLIC_BASE_URL=https://findhub.co.il

# ── Financial guardrail ─────────────────────────────────────────────────────
# LLM calls halt once this calendar month's AI spend reaches the cap (USD).
MAX_MONTHLY_AI_BUDGET_USD=5.0

# ── Telegram ────────────────────────────────────────────────────────────────
# Referenced by the (sports, he, telegram) social account (token_env_var / account_id_env_var).
TG_SPORTS_BOT_TOKEN=
TG_SPORTS_CHAT_ID=
# Defaults for Telegram accounts that do not name their own variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Append an "affiliate link" disclosure line to every post (recommended).
# AFFILIATE_DISCLOSURE=true

# ── Temu source (plugins/sources/temu_rapidapi.py) ──────────────────────────
# The source walks an ordered chain of RapidAPI Temu endpoints (config/temu_providers.yaml)
# and stops at the first one that returns usable products. Plans meter SEARCHES (free tiers:
# 5 to 50 a month), so each provider gets ONE search per run and everything else is local.
#
# One RapidAPI key works for every API the account is subscribed to: this one is used by
# every provider whose own variable below is empty.
RAPIDAPI_KEY=
# Optional key per provider (the names are set with `api_key_env` in temu_providers.yaml).
# Use them for keys of other RapidAPI accounts — each account has its own monthly quota.
RAPIDAPI_KEY_TEMU_1=
RAPIDAPI_KEY_TEMU_2=
RAPIDAPI_KEY_TEMU_3=
RAPIDAPI_KEY_TEMU_4=
# The chain file, relative to the project. Without the file only the first provider is used.
# TEMU_PROVIDERS_CONFIG_PATH=config/temu_providers.yaml
# Seconds to wait for a search that runs as a background job. A job that takes longer is not
# lost: collect it with   python main.py --seed-temu --category <id> --job <id>
# TEMU_JOB_TIMEOUT=300
# Moves the first TemuProductScraperAdapter provider to another RapidAPI host (prefer the chain file).
# RAPIDAPI_TEMU_HOST=temu-product-scraper.p.rapidapi.com
# Your Temu affiliate tracking value. Empty = plain product links (a warning is logged).
TEMU_TRACKING_ID=
# How the affiliate link is built from the product URL: {url} and {tracking_id} are filled in.
# TEMU_AFFILIATE_URL_TEMPLATE={url}?_x_sessn_id={tracking_id}&refer_page_name=affiliate
# Items requested per search (larger batch = more to rank locally for the same quota cost).
# TEMU_MAX_ITEMS=20
# Currency of the prices, for providers that do not report one.
# TEMU_CURRENCY=USD

# ── AliExpress source (plugins/sources/aliexpress_rapidapi.py) ──────────────
# The source walks an ordered chain of RapidAPI AliExpress endpoints
# (config/aliexpress_providers.yaml) and stops at the first one that returns usable products.
# Each variable below is optional: an empty one falls back to RAPIDAPI_KEY (above).
# Values are masked as [REDACTED] in every log line.
RAPIDAPI_KEY_ALI_1=
RAPIDAPI_KEY_ALI_2=
RAPIDAPI_KEY_ALI_3=
# The chain file, relative to the project. Without the file the same three providers are used.
# ALIEXPRESS_PROVIDERS_CONFIG_PATH=config/aliexpress_providers.yaml
# Your AliExpress Portals tracking id. Empty = the API's own promotion link, or the plain product URL.
ALIEXPRESS_TRACKING_ID=
# How the affiliate link is built from a plain product URL: {url} and {tracking_id} are filled in.
# A promotion link the API already returns is kept as-is.
# ALIEXPRESS_AFFILIATE_URL_TEMPLATE={url}?aff_fcid={tracking_id}&aff_platform=portals-tool
# Items requested per search, and the currency for providers that do not report one.
# ALIEXPRESS_MAX_ITEMS=20
# ALIEXPRESS_CURRENCY=USD

# ── Instagram (plugins/publishers/instagram_pub.py) ─────────────────────────
# Instagram API with Unified Login (graph.facebook.com, no Facebook Page needed):
# a Professional (Business/Creator) account in a Meta Business Portfolio and a
# Business Integration / System User token with instagram_business_basic and
# instagram_business_content_publish. Check with: python main.py --verify-instagram
# Each row of the social-accounts matrix names its own variables (token_env_var /
# account_id_env_var); accounts that name none fall back to these two.
# (gadgets, he, instagram):
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# (gadgets, en, instagram) — a separate English account:
INSTAGRAM_ACCESS_TOKEN_GADGETS_EN=
INSTAGRAM_BUSINESS_ACCOUNT_ID_GADGETS_EN=
# INSTAGRAM_GRAPH_API_VERSION=v21.0

# ── YouTube Shorts (plugins/publishers/youtube_pub.py) ──────────────────────
# YouTube Data API v3 with OAuth 2.0 (scope youtube.upload). One OAuth client (Google Cloud
# console > Credentials) and one refresh token per channel. Generate a refresh token with:
#   python -m plugins.publishers.youtube_pub --authorize client_secret.json
# Check with: python main.py --verify-youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# (gadgets, he, youtube) — also the default for channels that name no variable:
YOUTUBE_REFRESH_TOKEN=
# (gadgets, en, youtube):
YOUTUBE_REFRESH_TOKEN_GADGETS_EN=
# public | unlisted | private (unlisted while testing). Unaudited API projects only get private uploads.
# YOUTUBE_PRIVACY_STATUS=public
# Video category: 28 = Science & Technology, 22 = People & Blogs (default: 28 for tech collections, else 22).
# YOUTUBE_CATEGORY_ID=28
# Daily quota of the Google Cloud project; every upload costs 1,600 units (default 10,000 = 6 uploads/day).
# YOUTUBE_DAILY_QUOTA_UNITS=10000

# ── TikTok (plugins/publishers/tiktok_pub.py) ───────────────────────────────
# Content Posting API — Direct Post, user access token with the video.publish scope.
# Access tokens expire after 24 h: with the app's client key/secret and a refresh token (valid
# 365 days) the publisher refreshes automatically. Check with: python main.py --verify-tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Defaults for TikTok accounts that do not name their own variables:
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Per account of the matrix (token_env_var / account_id_env_var):
TIKTOK_ACCESS_TOKEN_GADGETS_HE=
TIKTOK_REFRESH_TOKEN_GADGETS_HE=
TIKTOK_ACCESS_TOKEN_GADGETS_EN=
TIKTOK_REFRESH_TOKEN_GADGETS_EN=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# Apps that have not passed TikTok's Direct Post audit must use SELF_ONLY.
# TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Commercial-content disclosure: none | your_brand | branded_content
# TIKTOK_COMMERCIAL_CONTENT=none

# ── Video generator (plugins/generators/ffmpeg_video_gen.py) ────────────────
# true = render product photos into a 1080x1920 H.264 slideshow (under 60 s) with ffmpeg (must be on PATH);
# YouTube Shorts and TikTok upload the video file itself, so they need this (or a source video).
# false = write a render-job manifest to output/render_jobs/ instead.
# VIDEO_RENDER_ENABLED=false

# ── Two-stage runs ──────────────────────────────────────────────────────────
# Stage 1 (--harvest): products kept per (category, source) per run.
HARVEST_LIMIT=20
# Stage 2 (--publish): default mode (override with --mode) and products per content type per run.
PUBLISHING_MODE=queued             # immediate | queued
PUBLISH_BATCH_LIMIT=5

# ── Storage ─────────────────────────────────────────────────────────────────
# local | supabase | cloud (cloud is a stub to implement). Production with videos or Stories: supabase,
# so generated media gets the public HTTPS URL Instagram needs.
STORAGE_MODE=local
LOCAL_MEDIA_DIR=output
MEDIA_RETENTION_DAYS=7             # 0 = never delete stored media
# STORAGE_MODE=supabase: the project URL, its service_role / secret key (server-side only, never in a
# browser) and a PUBLIC bucket created once in Supabase > Storage.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# ── Persistence & logging ───────────────────────────────────────────────────
# Production: the Supabase PostgreSQL connection string. When it is set, DATABASE_PATH is ignored.
# Supabase dashboard > Connect > "Transaction pooler" (port 6543) for Vercel and GitHub Actions;
# the tables are created on the first connection (or run core/schema_postgres.sql once by hand).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Connections kept open per process (keep it small: the Supabase pooler has a per-project limit).
# DATABASE_POOL_SIZE=4
# Local development: the SQLite file used when DATABASE_URL is not set.
DATABASE_PATH=tarshish_engine.db
# Folder of the seed files categories.yaml, content_profiles.yaml, social_accounts.yaml.
# They seed SQLite on the first start; push later edits with  python main.py --sync-config
CONFIG_DIR=config
LOG_LEVEL=INFO
# LOG_FILE=none logs to the console only (Vercel, GitHub Actions, Streamlit Cloud).
LOG_FILE=logs/tarshish_engine.log

# ── FindHub storefront API (python -m uvicorn storefront_api.server:app --port 8000) ───
# Browser origins allowed to call the API directly (comma-separated). The Next.js
# storefront proxies /api itself, so this only matters for other front ends.
# STOREFRONT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# A product is listed on the storefront only when it meets this standard.
# STOREFRONT_MIN_RATING=4.5
# STOREFRONT_MIN_ORDERS=200
# Seconds the CDN in front of the API (Vercel) may cache product and category listings. 0 = never.
# STOREFRONT_CACHE_SECONDS=60

# ── Optional HTTP admin API (/api/admin on the backend; the storefront never proxies it) ─────────
# Sent as the X-Admin-Key header by scripts that call the backend directly. 16+ characters; the admin
# API stays closed (503) while it is unset or still this example value. Operators normally use the
# Streamlit dashboard instead. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_SECRET=change_me_to_a_strong_secret
# Browser origins allowed to call this API directly (comma-separated).
# ALLOWED_ORIGINS=https://yourdomain.com,https://findhub.vercel.app
# Background jobs (harvest, publish …) are refused on a serverless host (VERCEL is set), where they
# would be frozen mid-run. Set this only if you know your host keeps functions alive.
# ADMIN_ALLOW_SERVERLESS_JOBS=

# ── Dashboard (Streamlit) ───────────────────────────────────────────────────
# Password for the dashboard. Required whenever DATABASE_URL is set: the dashboard refuses to open
# on a production database without one.
# DASHBOARD_PASSWORD=

# ── Queue worker (human-like pacing) ────────────────────────────────────────
WORKER_TIMEZONE=Asia/Jerusalem
WORKER_ACTIVE_HOURS_START=9        # posts only go out between these local hours
WORKER_ACTIVE_HOURS_END=22
WORKER_MIN_DELAY_SECONDS=600       # random gap between two posts on the same page
WORKER_MAX_DELAY_SECONDS=2700
WORKER_POLL_INTERVAL_SECONDS=30
