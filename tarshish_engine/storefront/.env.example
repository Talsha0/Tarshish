# Local development: copy to `.env.local` to change a default. Everything here is optional.
# On Vercel, set these in the storefront project's Settings > Environment Variables instead.

# Where the FastAPI backend listens. /api/backend/* (and the storefront's /api/*) are proxied there,
# and server-rendered pages call it directly. Read at BUILD time for the rewrites: redeploy after changing.
#   Local:  http://127.0.0.1:8000   (python -m uvicorn storefront_api.server:app --port 8000)
#   Vercel: the public URL of the backend, e.g. https://api.yourdomain.com   (REQUIRED on Vercel)
# API_ORIGIN, the older name, is still accepted.
BACKEND_API_URL=http://127.0.0.1:8000

# The admin portal (/admin): its login password, and the X-Admin-Key it adds server-side when calling
# the backend. Must equal ADMIN_API_SECRET on the backend. Server-only: never sent to the browser.
ADMIN_API_SECRET=change_me_to_a_strong_secret

# Public address of the storefront, used for canonical links and social previews.
# On Vercel it defaults to the project's production domain; set it once you add your own domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prices are stored in ILS. The English storefront shows an approximate USD price
# converted at this rate (shekels per dollar). Update it when the rate moves.
NEXT_PUBLIC_ILS_PER_USD=3.5
