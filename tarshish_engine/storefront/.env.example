# Copy to `.env.local` to change a default. Everything here is optional.

# Where the FastAPI storefront backend listens (python -m uvicorn api.server:app --port 8000).
# Requests to /api/* on the storefront are proxied there.
API_ORIGIN=http://127.0.0.1:8000

# Public address of the storefront, used for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prices are stored in ILS. The English storefront shows an approximate USD price
# converted at this rate (shekels per dollar). Update it when the rate moves.
NEXT_PUBLIC_ILS_PER_USD=3.5
